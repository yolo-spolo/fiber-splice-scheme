# Скопируйте этот файл в .env и заполните значения своими.
#   cp .env.example .env
# Проверить заполнение: npm run setup:check

# Строка подключения PostgreSQL. Значение подходит для `docker compose up -d`
# из этого репозитория (база на localhost:5433).
DATABASE_URL="postgresql://fiber:fiber@localhost:5433/fiber?schema=public"

# Необязательно. Пароль задаётся при первом запуске в браузере и хранится в БД.
# Переменная нужна только для наката на уже работающую установку: если она
# задана, вход по ней работает, пока пароль не сменят в Справочниках.
# AUTH_PASSWORD="change-me-strong"

# Ключ подписи сессионной куки. Сгенерируйте: openssl rand -hex 32
# Без него приложение отвечает 503 на всех страницах.
AUTH_SECRET="replace-with-32-random-bytes"

# Каталог для фото муфт (создаётся автоматически).
UPLOAD_DIR="./data/uploads"

# Внешний адрес приложения: используется в QR-кодах и публичных ссылках.
# От схемы зависит флаг Secure у куки: https:// — только TLS, http:// — в т.ч. локально.
APP_URL="http://localhost:3000"
